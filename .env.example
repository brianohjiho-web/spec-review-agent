ANTHROPIC_API_KEY=your_key_here

# Optional: use a different Claude model
# SPECCHECK_MODEL=claude-sonnet-5-5

# Optional: for a public demo
# APP_PASSWORD=choose_a_password
# DAILY_REVIEW_LIMIT=20

# Optional: check specs against a company's own products instead of public datasheets
# PRODUCT_API_URL=https://api.example.com/v1/products
# PRODUCT_API_KEY=their_key_here
# PRODUCT_API_AUTH=bearer
# Or use a saved file made by scripts/pull_from_api.py
# CATALOG_FILE=data/catalog_company.json
